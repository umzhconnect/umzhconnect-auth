# Install providers ONLY from the baked-in filesystem mirror — never reach out
# to registry.terraform.io. This is what removes the runtime proxy/egress
# dependency for `terraform init`.
provider_installation {
  filesystem_mirror {
    path    = "/providers"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}

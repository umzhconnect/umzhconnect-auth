# =============================================================================
# UMZH Connect Authentication Server - local development configuration
#
# All values here are DEMO credentials for local docker-compose use only.
# Production deployment uses a config snapshot of the Keycloak realm with
# real secrets injected at deploy time (out of scope for now).
# =============================================================================

# --- PostgreSQL (Keycloak backing store) ---
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_local_2026
POSTGRES_DB=keycloak

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Host port; also baked into KC_HOSTNAME and the published issuer
# http://localhost:8180/realms/umzh-connect (matches the umzhconnect-sandbox).
KEYCLOAK_PORT=8180

# --- JWKS server (serves Level-2 demo client public keys) ---
JWKS_PORT=8085

# --- Token validator (mock resource server, NOT a production artifact) ---
VALIDATOR_PORT=8086

# --- Level 1 client secrets (must match keycloak/terraform/variables.tf defaults) ---
PLACER_CLIENT_SECRET=placer-secret-2025
FULFILLER_CLIENT_SECRET=fulfiller-secret-2025

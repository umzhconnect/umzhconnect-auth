# =============================================================================
# Managed / external Postgres connection for local runs.
# Used by docker-compose.managed-db.yml.
#
#   cp .env.managed-db.example .env.managed-db
#   # edit .env.managed-db with your real values (it is gitignored)
#
# These override the bundled-postgres defaults in .env. Keycloak connects with
# KC_DB_URL = jdbc:postgresql://<HOST>:<PORT>/<NAME>?sslmode=<SSLMODE>
# =============================================================================

MANAGED_DB_HOST=your-db-host.example.com
MANAGED_DB_PORT=5432
MANAGED_DB_NAME=keycloak
MANAGED_DB_USER=keycloak
MANAGED_DB_PASSWORD=change-me

# require        - encrypt, no cert check (typical starting point for managed DBs)
# verify-full    - encrypt + verify hostname against a CA (needs a mounted CA cert)
# disable        - no TLS (only if TLS is terminated by a proxy/sidecar)
MANAGED_DB_SSLMODE=require

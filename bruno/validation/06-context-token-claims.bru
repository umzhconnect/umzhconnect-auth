meta {
  name: Validate context token claims (authorization_details + organization_reference)
  type: http
  seq: 6
}

post {
  url: {{validatorUrl}}/validate
  body: json
  auth: none
}

body:json {
  {
    "token": "{{fulfillerContextToken}}"
  }
}

docs {
  Verifies that the fulfiller context token (auth/08) carries the three IG-required claims beyond standard OAuth:

  1. authorization_details — the context the token is bound to: exactly one entry `{type: "http://fhir.ch/ig/ch-umzh-connect/context", identifier}` (security.md §Issued access token)
  2. extensions.umzhconnect.organization_reference — resolvable registry URL of the calling organization (IHE IUA extensions container pattern)
  3. aud — the constant ecosystem audience (ADR 0003), i.e. the realm issuer URL

  The /validate endpoint is the correctness oracle. JWT claims are additionally decoded in the post-response script for structural checks.

  Run auth/08 first to obtain fulfillerContextToken.
}

assert {
  res.status: eq 200
  res.body.valid: eq true
}

script:post-response {
  if (res.getStatus() !== 200) return;

  const token = bru.getVar("fulfillerContextToken");
  if (!token) {
    console.warn("fulfillerContextToken is not set — run auth/08 first");
    return;
  }

  const claims = JSON.parse(Buffer.from(token.split(".")[1], "base64url").toString());

  test("authorization_details carries exactly one context", () => {
    expect(claims.authorization_details).to.be.an("array").with.length(1);
    expect(claims.authorization_details[0].type).to.equal("http://fhir.ch/ig/ch-umzh-connect/context");
  });

  test("context identifier matches contextReference env var", () => {
    expect(claims.authorization_details[0].identifier).to.equal(bru.getEnvVar("contextReference"));
  });

  test("/validate reports the context check as pass", () => {
    const check = res.getBody().checks.find((c) => c.name === "context");
    expect(check.status).to.equal("pass");
  });

  test("extensions.umzhconnect.organization_reference is a non-empty string", () => {
    const orgRef = claims.extensions?.umzhconnect?.organization_reference;
    expect(orgRef).to.be.a("string").that.is.not.empty;
  });

  test("organization_reference is the Fulfiller org URL", () => {
    const orgRef = claims.extensions?.umzhconnect?.organization_reference;
    expect(orgRef).to.include("hospital_b");
  });

  test("aud is the constant ecosystem audience", () => {
    const aud = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
    const expectedAud = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}`;
    expect(aud).to.include(expectedAud);
  });

  test("scope contains system/ServiceRequest.rs", () => {
    expect(claims.scope || "").to.include("system/ServiceRequest.rs");
  });

  test("iss is the realm issuer", () => {
    const expectedIss = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}`;
    expect(claims.iss).to.equal(expectedIss);
  });

  console.log("All IG claims present. aud:", JSON.stringify(claims.aud));
  console.log("organization_reference:", claims.extensions?.umzhconnect?.organization_reference);
}

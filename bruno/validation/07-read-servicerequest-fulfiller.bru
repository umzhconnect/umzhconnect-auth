meta {
  name: Read ServiceRequest as Fulfiller (context-gated, cross-org)
  type: http
  seq: 7
}

get {
  url: {{validatorUrl}}/fhir/ServiceRequest/sr-123
  body: none
  auth: bearer
}

auth:bearer {
  token: {{fulfillerContextToken}}
}

docs {
  Demonstrates the complete Fulfiller → Placer access flow from security.md: the fulfiller presents its context token (auth/08) — whose `authorization_details` claim names the workflow root ServiceRequest/sr-123 — to read the ServiceRequest itself.

  This exercises the same context gate as validation/04 but in the Fulfiller → Placer direction: a different client, a different organization_reference, and a ServiceRequest rather than a Task as the workflow root.

  Run auth/08 first to obtain fulfillerContextToken.
}

assert {
  res.status: eq 200
  res.body.resourceType: eq ServiceRequest
}

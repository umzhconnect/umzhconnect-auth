meta {
  name: Read Patient (in the context graph)
  type: http
  seq: 3
}

get {
  url: {{validatorUrl}}/fhir/Patient/pat-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{fulfillerContextToken}}
}

docs {
  The Fulfiller reads the Patient referenced by the order, using its context token (auth/08, context `ServiceRequest/sr-123`, scope `system/Patient.rs`). Patient is context-gated (every type except Task and Questionnaire is), so the mock checks all three IG steps: exactly one context, hospital_b is the counter-party recorded for `ServiceRequest/sr-123`, and `Patient/pat-1` is in that root's context graph. Contrast with negative/14 (resource outside the graph). Run auth/08 first.
}

assert {
  res.status: eq 200
  res.body.resourceType: eq Patient
}

meta {
  name: AS JWKS (token signature keys)
  type: http
  seq: 2
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/certs
  body: none
  auth: none
}

docs {
  Fetches the AS's own public key set — what resource servers use to
  verify the signature on every access token it issues. Sanity-checks
  that the JWKS endpoint is up and returns at least one key.
}

assert {
  res.status: eq 200
  res.body.keys: isDefined
}

meta {
  name: Get Placer Token (L2 + RFC 9396 context)
  type: http
  seq: 5
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{placerClientId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{placerClientAssertion}}
  scope: system/DiagnosticReport.rs
  authorization_details: [{"type":"http://fhir.ch/ig/ch-umzh-connect/context","identifier":"{{taskContextReference}}"}]
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:pre-request {
  // Signs an RFC 7523 client assertion with the demo placer private key.
  // Requires Bruno "developer mode" (filesystem access).
  // Override key location with the l2KeysDir environment var.
  const crypto = require("crypto");
  const fs = require("fs");
  const path = require("path");
  
  const keysDir = bru.getEnvVar("l2KeysDir") || path.resolve(bru.cwd(), "..", "keys");
  const pem = fs.readFileSync(path.join(keysDir, "hospital_a-l2.key"), "utf8");
  
  const b64url = (obj) => Buffer.from(JSON.stringify(obj)).toString("base64url");
  const now = Math.floor(Date.now() / 1000);
  const tokenEndpoint = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`;
  
  const clientId = bru.getEnvVar("placerClientId");
  const header = { alg: "RS256", typ: "JWT", kid: "hospital_a-l2" };
  const payload = {
    iss: clientId,
    sub: clientId,
    aud: tokenEndpoint,
    exp: now + 60,
    jti: crypto.randomUUID(),
  };
  
  const signingInput = `${b64url(header)}.${b64url(payload)}`;
  const signature = crypto
    .sign("RSA-SHA256", Buffer.from(signingInput), pem)
    .toString("base64url");
  
  bru.setVar("placerClientAssertion", `${signingInput}.${signature}`);
}

script:post-response {
  if (res.getStatus() !== 200) return;
  
  const token = res.getBody().access_token;
  bru.setVar("placerContextToken", token);
  
  const claims = JSON.parse(Buffer.from(token.split(".")[1], "base64url").toString());
  
  const expected = [{ type: "http://fhir.ch/ig/ch-umzh-connect/context", identifier: bru.getEnvVar("taskContextReference") }];

  test("authorization_details claim carries exactly the requested context", () => {
    expect(claims.authorization_details).to.deep.equal(expected);
  });

  test("token response returns the granted authorization_details (RFC 9396 §7)", () => {
    expect(res.getBody().authorization_details).to.deep.equal(expected);
  });

  test("no legacy fhirContext claim", () => {
    expect(claims.fhirContext).to.be.undefined;
  });
  
  test("organization_reference is present in extensions", () => {
    expect(claims.extensions?.umzhconnect?.organization_reference).to.be.a("string").that.is.not.empty;
  });
  
  console.log("authorization_details:", JSON.stringify(claims.authorization_details));
  console.log("aud:", JSON.stringify(claims.aud));
  console.log("organization_reference:", claims.extensions?.umzhconnect?.organization_reference);
}

docs {
  Placer (hospital_a) requests an L2 token to read the output of a Task on the Fulfiller's server: the RFC 9396 `authorization_details` parameter names the workflow root `{{taskContextReference}}` (type `http://fhir.ch/ig/ch-umzh-connect/context`). The `umzh-context` client policy stores the context, normalised to `{type, identifier}`, and the built-in session note mapper writes it as a top-level `authorization_details` claim and into the token response. validation/04 uses the token to read the Task's output.
  
  Requires Bruno developer mode (unsafe sandbox) for crypto/fs/path.
}

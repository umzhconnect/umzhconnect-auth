meta {
  name: Get Fulfiller Token (L2 + RFC 9396 context)
  type: http
  seq: 8
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{fulfillerClientId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{fulfillerClientAssertion}}
  scope: system/ServiceRequest.rs system/Patient.r
  authorization_details: [{"type":"umzh-connect-context","identifier":"{{contextReference}}"}]
}

docs {
  Canonical IG example (security.md §Context-centric authorization): the Fulfiller fetches from the Placer's FHIR server in the context of a specific ServiceRequest. The token carries fhirContext with the ServiceRequest reference; aud is the constant ecosystem audience (ADR 0003).

  This mirrors auth/05 but uses the fulfiller client (hospital-b).

  Requires Bruno developer mode (unsafe sandbox) for crypto/fs/path.
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:pre-request {
  const crypto = require("crypto");
  const fs = require("fs");
  const path = require("path");

  const keysDir = bru.getEnvVar("l2KeysDir") || path.resolve(bru.cwd(), "..", "keys");
  const pem = fs.readFileSync(path.join(keysDir, "fulfiller-l2.key"), "utf8");

  const b64url = (obj) => Buffer.from(JSON.stringify(obj)).toString("base64url");
  const now = Math.floor(Date.now() / 1000);
  const tokenEndpoint = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`;

  const clientId = bru.getEnvVar("fulfillerClientId");
  const header = { alg: "RS256", typ: "JWT", kid: "fulfiller-l2" };
  const payload = {
    iss: clientId,
    sub: clientId,
    aud: tokenEndpoint,
    iat: now,
    exp: now + 60,
    jti: crypto.randomUUID(),
  };

  const signingInput = `${b64url(header)}.${b64url(payload)}`;
  const signature = crypto
    .sign("RSA-SHA256", Buffer.from(signingInput), pem)
    .toString("base64url");

  bru.setVar("fulfillerClientAssertion", `${signingInput}.${signature}`);
}

script:post-response {
  if (res.getStatus() !== 200) return;

  const token = res.getBody().access_token;
  bru.setVar("fulfillerContextToken", token);

  const claims = JSON.parse(Buffer.from(token.split(".")[1], "base64url").toString());

  test("fhirContext is present and matches requested reference", () => {
    expect(claims.fhirContext).to.be.an("array").with.length.greaterThan(0);
    expect(claims.fhirContext[0].reference).to.equal(bru.getEnvVar("contextReference"));
  });

  test("organization_reference is present in extensions", () => {
    expect(claims.extensions?.umzhconnect?.organization_reference).to.be.a("string").that.is.not.empty;
  });

  test("aud is the constant ecosystem audience", () => {
    const aud = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
    const expectedAud = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}`;
    expect(aud).to.include(expectedAud);
  });

  console.log("fhirContext:", JSON.stringify(claims.fhirContext));
  console.log("aud:", JSON.stringify(claims.aud));
  console.log("organization_reference:", claims.extensions?.umzhconnect?.organization_reference);
}

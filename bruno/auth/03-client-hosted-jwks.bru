meta {
  name: Client Hosted JWKS (client key, L2)
  type: http
  seq: 3
}

get {
  url: {{jwksServerUrl}}/.well-known/{{jwksKeyName}}.jwks.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.keys: isDefined
}

docs {
  Fetches an L2 client's own hosted JWKS — the public key set Keycloak fetches from `jwks.url` to verify that client's `private_key_jwt` assertions (see [ai-docs/infrastructure.md](../../ai-docs/infrastructure.md)). Hosted at `/.well-known/{hospital_name}-l2.jwks.json` by convention — this filename is independent of KC `client_id` (which is `hospital_a-l2`), so it's driven by its own `jwksKeyName` environment variable, not `clientId`. Defaults to the placer (`jwksKeyName: hospital_a-l2`) — set it to `hospital_b-l2` (or override inline) to fetch the fulfiller's instead, since there's no per-role distinction on this request. This stands in for the sandbox's APISIX-published `/jwks.json`, not the AS's own signing keys (that's `02-jwks.bru`).
}

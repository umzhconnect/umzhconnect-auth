meta {
  name: Get Fulfiller Token (L1, client_secret)
  type: http
  seq: 4
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{fulfillerClientId}}
  client_secret: {{fulfillerClientSecret}}
  scope: system/Task.cru system/ServiceRequest.r system/Patient.r system/Organization.r
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("fulfillerToken", res.getBody().access_token);
  }
}

meta {
  name: OIDC Discovery
  type: http
  seq: 1
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/.well-known/openid-configuration
  body: none
  auth: none
}

docs {
  Fetches the realm's OIDC discovery document. Confirms the realm exists and is reachable, and that the issuer matches `{{keycloakUrl}}/realms/{{realm}}` — every downstream request's `iss` and audience checks assume this value is correct.
}

assert {
  res.status: eq 200
  res.body.issuer: eq {{keycloakUrl}}/realms/{{realm}}
  res.body.token_endpoint: isDefined
  res.body.jwks_uri: isDefined
}

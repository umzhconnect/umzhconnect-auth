meta {
  name: Unknown authorization_details type — no fhirContext in token (200)
  type: http
  seq: 8
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{placerClientId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{placerClientAssertion}}
  scope: system/ServiceRequest.rs system/Patient.r
  authorization_details: [{"type":"unknown-context-type","identifier":"ServiceRequest/sr-123"}]
}

docs {
  Sends a syntactically valid authorization_details array but with an
  unrecognized type ("unknown-context-type" instead of "umzh-connect-context").
  FhirContextMapper only processes type "umzh-connect-context" and silently
  skips everything else — so a token is issued, but with no fhirContext claim.

  Expected: KC issues a 200 token. The post-response script decodes the JWT
  and asserts that fhirContext is ABSENT.

  This documents the silent behavior for unknown types. A client sending this
  would then fail at the Resource Server's context gate (see validation/04 and
  negative/04) because the token lacks fhirContext.

  Related open gap: FhirContextMapper.java:98 also swallows parse errors on
  malformed JSON, producing the same silent outcome (open-gaps.md §2).

  Requires Bruno developer mode (unsafe sandbox) for crypto/fs/path.
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:pre-request {
  const crypto = require("crypto");
  const fs = require("fs");
  const path = require("path");

  const keysDir = bru.getEnvVar("l2KeysDir") || path.resolve(bru.cwd(), "..", "keys");
  const pem = fs.readFileSync(path.join(keysDir, "placer-l2.key"), "utf8");

  const b64url = (obj) => Buffer.from(JSON.stringify(obj)).toString("base64url");
  const now = Math.floor(Date.now() / 1000);
  const tokenEndpoint = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`;

  const clientId = bru.getEnvVar("placerClientId");
  const header = { alg: "RS256", typ: "JWT", kid: "placer-l2" };
  const payload = {
    iss: clientId,
    sub: clientId,
    aud: tokenEndpoint,
    iat: now,
    exp: now + 60,
    jti: crypto.randomUUID(),
  };

  const signingInput = `${b64url(header)}.${b64url(payload)}`;
  const signature = crypto
    .sign("RSA-SHA256", Buffer.from(signingInput), pem)
    .toString("base64url");

  bru.setVar("placerClientAssertion", `${signingInput}.${signature}`);
}

script:post-response {
  if (res.getStatus() !== 200) return;

  const token = res.getBody().access_token;
  const claims = JSON.parse(Buffer.from(token.split(".")[1], "base64url").toString());

  test("fhirContext is absent when type is unrecognized", () => {
    expect(claims.fhirContext).to.be.undefined;
  });

  console.log("fhirContext (should be undefined):", claims.fhirContext);
}

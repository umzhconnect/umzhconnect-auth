meta {
  name: Read ServiceRequest without context (403)
  type: http
  seq: 4
}

get {
  url: {{validatorUrl}}/fhir/ServiceRequest/sr-123
  body: none
  auth: bearer
}

auth:bearer {
  token: {{placerL2Token}}
}

docs {
  placerL2Token (auth/06) has the system/ServiceRequest.rs scope but no context in `authorization_details`. ServiceRequest is context-gated, and the IG requires exactly one context for such requests, so the read is rejected with 403.
}

assert {
  res.status: eq 403
}

meta {
  name: Read Questionnaire without requesting the scope (403)
  type: http
  seq: 3
}

get {
  url: {{validatorUrl}}/fhir/Questionnaire/q-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{placerL2Token}}
}

docs {
  placerL2Token (auth/06) requests `system/Task.crus system/ServiceRequest.rs system/Patient.rs` — not `system/Questionnaire.rs`. No scope is ever included in a token unless explicitly requested (scopes.yaml registers every scope as optional, none as default), so the read is rejected. Questionnaire is used because it is not context-gated: the token needs no context, so the 403 can only come from the scope check. (Organization was used before; cross-domain Organization data comes from the public registry, so the mock no longer serves it.) Run auth/06 first to obtain placerL2Token.
}

assert {
  res.status: eq 403
}

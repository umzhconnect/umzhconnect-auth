meta {
  name: Read Organization with default scope (200)
  type: http
  seq: 3
}

get {
  url: {{validatorUrl}}/fhir/Organization/org-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{placerL2Token}}
}

docs {
  system/Organization.r is a default scope on all hospital M2M clients
  (scopes.yaml), so hospital-a's token includes it and the read succeeds.
  This request formerly expected 403 when scopes were per-client; it now
  verifies the opposite: default scopes are present and enforced correctly.
  Run auth/06 first to obtain placerL2Token.
}

assert {
  res.status: eq 200
}

meta {
  name: Read Organization without scope (403)
  type: http
  seq: 3
}

get {
  url: {{validatorUrl}}/fhir/Organization/org-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{placerL2Token}}
}

docs {
  The placer client is not granted system/Organization.r (only the fulfiller
  is), so this read must be rejected with 403.
  Run auth/06 first to obtain placerL2Token.
}

assert {
  res.status: eq 403
}

meta {
  name: Read Organization without scope (403)
  type: http
  seq: 3
}

get {
  url: {{validatorUrl}}/fhir/Organization/org-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{placerL2Token}}
}

docs {
  hospital-a's token does not include system/Organization.r (only hospital-b
  does in the token validator's scope checks), so this read must be rejected
  with 403.
  Run auth/06 first to obtain placerL2Token.
}

assert {
  res.status: eq 403
}

meta {
  name: Get Fulfiller token for a context it is not party to (200)
  type: http
  seq: 15
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{fulfillerClientId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{fulfillerClientAssertion}}
  scope: system/DiagnosticReport.rs
  authorization_details: [{"type":"http://fhir.ch/ig/ch-umzh-connect/context","identifier":"{{taskContextReference}}"}]
}

docs {
  Setup for negative/16. The Fulfiller (hospital_b) asks for a token bound to `{{taskContextReference}}` — a Task on which the Placer (hospital_a) is the requester. The AS issues it: `authorization_details` is client-asserted, and the AS does not consult workflow data (IG: counter-party entitlement is a Resource Server obligation). Stores the token as `foreignContextToken`.

  Requires Bruno developer mode (unsafe sandbox) for crypto/fs/path.
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:pre-request {
  const crypto = require("crypto");
  const fs = require("fs");
  const path = require("path");

  const keysDir = bru.getEnvVar("l2KeysDir") || path.resolve(bru.cwd(), "..", "keys");
  const pem = fs.readFileSync(path.join(keysDir, "hospital_b-l2.key"), "utf8");

  const b64url = (obj) => Buffer.from(JSON.stringify(obj)).toString("base64url");
  const now = Math.floor(Date.now() / 1000);
  const tokenEndpoint = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`;

  const clientId = bru.getEnvVar("fulfillerClientId");
  const header = { alg: "RS256", typ: "JWT", kid: "hospital_b-l2" };
  const payload = {
    iss: clientId,
    sub: clientId,
    aud: tokenEndpoint,
    iat: now,
    exp: now + 60,
    jti: crypto.randomUUID(),
  };

  const signingInput = `${b64url(header)}.${b64url(payload)}`;
  const signature = crypto
    .sign("RSA-SHA256", Buffer.from(signingInput), pem)
    .toString("base64url");

  bru.setVar("fulfillerClientAssertion", `${signingInput}.${signature}`);
}

script:post-response {
  if (res.getStatus() !== 200) return;
  bru.setVar("foreignContextToken", res.getBody().access_token);
}

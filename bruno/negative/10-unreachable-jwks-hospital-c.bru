meta {
  name: Hospital C client auth fails — jwks_url unreachable locally (400)
  type: http
  seq: 10
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: hospital_c-l2
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{hospitalCClientAssertion}}
  scope: system/Patient.r
}

docs {
  Hospital C is onboarded (`config/clients/hospital_c-l2.yaml` exists, so Terraform provisions its KC client) but its `jwks_url` points at a real external host (`https://hospital-c.example/.well-known/jwks.json`), not the local `jwks-server` — unlike hospital-a/hospital-b, there's no matching `keys/hospital-c.key` or `keys/.well-known/hospital-c.jwks.json` demo material in this repo.

  The pre-request script generates a throwaway RSA keypair purely to produce a syntactically valid RFC 7523 assertion — the signature itself is irrelevant to this test, since Keycloak can't reach `hospital-c.example` from this environment to fetch the JWKS and verify it against in the first place. The request must fail regardless of what key signed it.

  Demonstrates that onboarding a hospital (adding its YAML file) is not by itself sufficient for that client to authenticate — its `jwks_url` must also be reachable and actually serve the right key, which for hospital-c it deliberately isn't in this local/demo setup.

  Requires Bruno developer mode (unsafe sandbox) for crypto/fs/path.
}

assert {
  res.status: eq 400
}

script:pre-request {
  const crypto = require("crypto");

  const { privateKey } = crypto.generateKeyPairSync("rsa", { modulusLength: 2048 });

  const b64url = (obj) => Buffer.from(JSON.stringify(obj)).toString("base64url");
  const now = Math.floor(Date.now() / 1000);
  const tokenEndpoint = `${bru.getEnvVar("keycloakUrl")}/realms/${bru.getEnvVar("realm")}/protocol/openid-connect/token`;

  const clientId = "hospital_c-l2";
  const header = { alg: "RS256", typ: "JWT", kid: "hospital-c" };
  const payload = {
    iss: clientId,
    sub: clientId,
    aud: tokenEndpoint,
    exp: now + 60,
    jti: crypto.randomUUID(),
  };

  const signingInput = `${b64url(header)}.${b64url(payload)}`;
  const signature = crypto
    .sign("RSA-SHA256", Buffer.from(signingInput), privateKey)
    .toString("base64url");

  bru.setVar("hospitalCClientAssertion", `${signingInput}.${signature}`);
}

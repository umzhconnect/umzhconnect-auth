meta {
  name: Token with wrong secret (401)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{placerClientId}}
  client_secret: definitely-not-the-secret
  scope: system/Patient.r
}

assert {
  res.status: eq 401
}

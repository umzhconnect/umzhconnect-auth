meta {
  name: Wrong auth method — client_secret against L2 client (401)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{placerClientId}}
  client_secret: definitely-not-valid
  scope: system/Patient.r
}

docs {
  Presents a `client_secret` grant to a client provisioned as L2 (`private_key_jwt`-only). The AS must reject this regardless of what the secret value is — L2 clients don't accept `client_secret` authentication at all. Confirms the production integration path can't be bypassed with a guessed or leaked secret. (`client_secret` is only valid against a hospital's separately-provisioned, opt-in L1 debug client — see ADR 0004 and docs/use-cases/technical.md UC-T8.)
}

assert {
  res.status: eq 400
}

meta {
  name: Validate garbage token (422)
  type: http
  seq: 2
}

post {
  url: {{validatorUrl}}/validate
  body: json
  auth: none
}

body:json {
  {
    "token": "not.a.jwt"
  }
}

docs {
  Sends a string that isn't a well-formed JWT to the token-validator's
  `/validate` endpoint. Confirms the validator fails closed on malformed
  input (422, `valid: false`) instead of throwing an unhandled error or
  treating an unparseable token as implicitly valid.
}

assert {
  res.status: eq 422
  res.body.valid: eq false
}
